{
  "build": {
    "appId": "com.2gosoo.videoagent",
    "files": [
      "main.js",
      "preload.js",
      "engine.js",
      "tts.js",
      "analysis.js",
      "whisper.js",
      "renderer/**",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "assets/fonts",
        "to": "fonts"
      },
      {
        "from": "assets/whisper",
        "to": "whisper"
      }
    ],
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "category": "public.app-category.video",
      "target": "dmg",
      "extendInfo": {
        "NSCameraUsageDescription": "영상 녹화를 위해 카메라를 사용합니다.",
        "NSMicrophoneUsageDescription": "영상 녹화와 나레이션을 위해 마이크를 사용합니다."
      }
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false
    },
    "productName": "Video Agent Studio",
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "pdfjs-dist": "^4.10.38"
  },
  "description": "이미지나 영상을 넣으면 분석, 대본, 나레이션, 자막, 합성까지 자동으로 만드는 데스크톱 영상 제작 앱",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "main": "main.js",
  "name": "video-agent-studio",
  "scripts": {
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "engine-test": "node engine-test.js",
    "start": "electron ."
  },
  "version": "0.7.0"
}
