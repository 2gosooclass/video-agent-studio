{
  "name": "video-agent-studio",
  "version": "0.8.0",
  "description": "AI Shorts & Reels Production Studio with Gemini 2.5 Flash & Whisper",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "pdfjs-dist": "^4.10.38"
  },
  "build": {
    "appId": "com.twogosoo.videoagentstudio",
    "productName": "Video Agent Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!assets/whisper/**",
      "!dist/**",
      "!*.dmg"
    ],
    "extraResources": [
      {
        "from": "assets/bgm",
        "to": "assets/bgm"
      },
      {
        "from": "assets/fonts",
        "to": "assets/fonts"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}